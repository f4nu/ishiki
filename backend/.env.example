# AnkiWeb login (your own account)
ANKI_USERNAME=you@example.com
ANKI_PASSWORD=your-ankiweb-password

# Leave blank for AnkiWeb; set only for a custom/self-hosted sync server
ANKI_SYNC_ENDPOINT=

# Shared secret the Pebble app must send as: Authorization: Bearer <token>
# Use a long random string, e.g. `openssl rand -hex 32`
API_TOKEN=change-me-to-a-long-random-string

# Where the local synced collection is stored
# (in Docker this is overridden to /data/collection.anki2 on a persistent volume)
COLLECTION_PATH=./data/collection.anki2

# Seconds between automatic background syncs to AnkiWeb
SYNC_INTERVAL=120
